# Copy this file to ".env" and fill in real values later.
# Never share or commit your real .env file.

# Port for the AgriLearn API server
PORT=5000

# Set automatically in production. For local HTTPS reverse proxies only, use 1.
# TRUST_PROXY=1

# Frontend URL(s) allowed to call this API (comma-separated if Vite uses another port)
CLIENT_URL=http://localhost:5173,http://localhost:5174
# Optional. Public website base used in Level Admin invitation links (no trailing slash).
# If unset, the first CLIENT_URL value is used.
# PUBLIC_APP_URL=https://myagrilearn.vercel.app

# MongoDB — Atlas OR local (local avoids IP whitelist issues: docker compose up -d)
# IMPORTANT: The database name in the URI must match where your data already lives.
# AgriLearn accounts created before a named DB was set usually live in Atlas "test".
# Changing the DB name (e.g. to agrilearn) points at an EMPTY database and login fails.
# Atlas example (existing AgriLearn data):
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/test?retryWrites=true&w=majority
# Local example:
# MONGODB_URI=mongodb://127.0.0.1:27017/agrilearn
MONGODB_URI=
# Optional. Only set if the URI has no DB path and you want to force one.
# MONGODB_DB_NAME=test

# Long random string used to sign login tokens (never share this)
JWT_SECRET=

# Support inbox that receives homepage contact and dashboard Contact Us mail.
# Dashboard support messages are still saved to MongoDB even when email fails.
# On Render, set these on the API service (not on Vercel):
SUPPORT_EMAIL=

# Gmail SMTP (use a Google App Password — never a normal account password)
# Example for Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=your-gmail-address@gmail.com
#   SMTP_PASS=your-16-character-app-password
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Password reset emails reuse these SMTP settings. They never include the user's password.
# Reset links use PUBLIC_APP_URL (or the first CLIENT_URL). On Render set:
# PUBLIC_APP_URL=https://myagrilearn.vercel.app

# Google Gemini API — FREE TIER ONLY (never put this key in the frontend)
# Create a key in Google AI Studio without enabling billing.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free-tier model id for NEW AI Studio keys (default: gemini-3.5-flash-lite)
# gemini-2.5-flash-lite returns 404 for new users — do not use it.
# Change only to another free-tier model shown in AI Studio. Never enable billing.
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloudinary — permanent storage for notes, past questions, Community chat, and avatars.
# Create a free account at https://cloudinary.com and copy API credentials from the dashboard.
# On Render, set the same three variables (or a single CLOUDINARY_URL) on the API service.
# Local development: copy those values into this backend/.env file, then restart the API.
# Never commit real credentials. Uploads use authenticated Cloudinary assets; students and
# admins never receive permanent public file URLs — files stream through JWT-protected APIs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional single URL form (cloudinary://API_KEY:API_SECRET@CLOUD_NAME). Used only when
# the three variables above are empty.
# CLOUDINARY_URL=
# Optional folder prefix inside Cloudinary (default: agrilearn)
# CLOUDINARY_FOLDER=agrilearn

# Optional: absolute path for legacy local uploads (default: backend/uploads)
# Existing MongoDB storagePath values that point at local disk remain readable (dual storage).
# New uploads require Cloudinary credentials above (no local write fallback).
# Upload size limits (enforced in code, not env):
#   Notes / past questions: PDF 25 MB, image 10 MB each, multi-image total 50 MB
#   Community chat: PDF 20 MB, image 10 MB
#   Student profile pictures: 5 MB
# UPLOADS_DIR=

# First AgriLearn administrator (used only by: npm run seed:admin)
# Never commit real passwords. There is no public admin registration.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=AgriLearn Admin
# Set to 1 only when intentionally adding another admin after the first exists
# ADMIN_FORCE=
