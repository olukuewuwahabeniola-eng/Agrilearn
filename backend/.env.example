# Copy this file to ".env" and fill in real values later.
# Never share or commit your real .env file.

# Port for the AgriLearn API server
PORT=5000

# Frontend URL(s) allowed to call this API (comma-separated if Vite uses another port)
CLIENT_URL=http://localhost:5173,http://localhost:5174
# Optional. Public website base used in Level Admin invitation links (no trailing slash).
# If unset, the first CLIENT_URL value is used.
# PUBLIC_APP_URL=https://your-agrilearn-domain.com

# MongoDB — Atlas OR local (local avoids IP whitelist issues: docker compose up -d)
# IMPORTANT: The database name in the URI must match where your data already lives.
# AgriLearn accounts created before a named DB was set usually live in Atlas "test".
# Changing the DB name (e.g. to agrilearn) points at an EMPTY database and login fails.
# Atlas example (existing AgriLearn data):
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/test?retryWrites=true&w=majority
# Local example:
# MONGODB_URI=mongodb://127.0.0.1:27017/agrilearn
MONGODB_URI=
# Optional. Only set if the URI has no DB path and you want to force one.
# MONGODB_DB_NAME=test

# Long random string used to sign login tokens (never share this)
JWT_SECRET=

# Support inbox that receives Contact Us notifications
# Messages are still saved to MongoDB even when email is unset/unconfigured.
SUPPORT_EMAIL=

# Gmail SMTP (use a Google App Password — never a normal account password)
# Example for Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=your-gmail-address@gmail.com
#   SMTP_PASS=your-16-character-app-password
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Google Gemini API — FREE TIER ONLY (never put this key in the frontend)
# Create a key in Google AI Studio without enabling billing.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free-tier model id for NEW AI Studio keys (default: gemini-3.5-flash-lite)
# gemini-2.5-flash-lite returns 404 for new users — do not use it.
# Change only to another free-tier model shown in AI Studio. Never enable billing.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: absolute path for uploaded files (default: backend/uploads)
# Stores lecture PDFs (notes/) and past examination papers (past-questions/).
# Files are served only through authenticated API routes — not public static URLs.
# Upload size limits (enforced in code, not env): PDF 25 MB, image 10 MB each,
# multi-image past papers 50 MB combined. Storage is local disk — ensure the host
# volume has enough free space. There is no Cloudinary/S3 provider in this stack.
# UPLOADS_DIR=

# First AgriLearn administrator (used only by: npm run seed:admin)
# Never commit real passwords. There is no public admin registration.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=AgriLearn Admin
# Set to 1 only when intentionally adding another admin after the first exists
# ADMIN_FORCE=
