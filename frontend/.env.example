# Copy values into ".env.local" as needed.
# Never put secrets (JWT, MongoDB URI, SMTP passwords) in the frontend.

# Backend API URL (Express server). On Vercel this must be the Render API URL:
# VITE_API_URL=https://agrilearn-cyzs.onrender.com
VITE_API_URL=http://localhost:5000

# Homepage contact, dashboard support, and password-reset emails are sent by
# the backend using SMTP_HOST / SMTP_USER / SMTP_PASS / SUPPORT_EMAIL.
# Do not put those values in Vercel frontend env.
