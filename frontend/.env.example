# Copy values into ".env.local" as needed.
# Never put secrets (JWT, MongoDB URI, EmailJS Private Key) in the frontend.

# Backend API URL (Express server)
VITE_API_URL=http://localhost:5000

# EmailJS (public values only)
# Template variables: {{name}} {{email}} {{title}} {{message}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=template_e3m6pka
VITE_EMAILJS_PUBLIC_KEY=
